# Local ADK Web development with Google AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=False
GOOGLE_API_KEY=replace-me

# Optional Gemini settings. Defaults are shown.
# APPRAISAL_GEMINI_LIVE_MODEL=gemini-3.8-live
# APPRAISAL_VISION_MODEL=gemini-3.8-flash
# APPRAISAL_VALUATION_MODEL=gemini-3.8-flash
# APPRAISAL_SKETCH_MODEL=gemini-3.1-flash-image
# APPRAISAL_VOICE=Kore
# Pricing location used until the claimant names one, as "City, Country".
# APPRAISAL_DEFAULT_LOCALE=Mumbai, India

# Optional OpenAI providers, for a free Google key: it allows only a few frame reads a
# minute, and has little or no Google Search or image quota. Each step switches on its own.
# OPENAI_API_KEY=your-openai-key
# APPRAISAL_VISION_PROVIDER=openai
# APPRAISAL_PRICING_PROVIDER=openai
# APPRAISAL_SKETCH_PROVIDER=openai
# APPRAISAL_OPENAI_VISION_MODEL=gpt-5.4-mini
# APPRAISAL_OPENAI_MODEL=gpt-5.4-mini
# APPRAISAL_OPENAI_SKETCH_MODEL=gpt-image-2

# Optional live avatar. Needs Application Default Credentials (gcloud auth application-default login).
# Leave APPRAISAL_AVATAR_NAME and APPRAISAL_AVATAR_IMAGE unset for voice-only mode.
# APPRAISAL_AVATAR_NAME=Kira
# APPRAISAL_AVATAR_PROJECT=your-project-id
# APPRAISAL_AVATAR_LOCATION=us-central1
# APPRAISAL_AVATAR_VOICE=Kore
# APPRAISAL_AVATAR_IMAGE=/path/to/portrait.png

# Optional Vertex AI settings for future Agent Platform work.
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
